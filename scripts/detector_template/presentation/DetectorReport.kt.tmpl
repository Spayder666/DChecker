fun {{Class}}CardModel.toDetectorReport(): DetectorReport = DetectorReport(
    title = title,
    verdict = verdict,
    severity = status.severity,
    quickFacts = emptyList(),
    blocks = listOf(
        ReportBlock.Rows("Signals", signalRows.toReportRows()),
        ReportBlock.Rows("Scan", scanRows.toReportRows()),
    ),
)

private fun List<{{Class}}DetailRowModel>.toReportRows(): List<ReportRow> =
    map { ReportRow(it.label, it.value, it.detail) }
